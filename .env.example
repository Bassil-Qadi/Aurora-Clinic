# =============================================================================
# Clinic SaaS Starter — environment configuration
#
# Copy this file to `.env.local` and fill in the values:
#     cp .env.example .env.local
#
# Only the variables under "REQUIRED" are needed to boot the app. Every
# integration below that is optional — when its keys are absent the feature
# degrades gracefully (emails and WhatsApp messages are logged to the console,
# AI summaries fall back to a template-generated summary, and the billing
# pages report that payments are not configured).
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the app will not start without these
# -----------------------------------------------------------------------------

# MongoDB connection string. A free Atlas cluster works fine for development:
# https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb://127.0.0.1:27017/clinic-system

# Secret used by NextAuth to sign staff session tokens (clinic dashboard).
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL of this deployment. Must match the browser origin exactly,
# including protocol and port, or sign-in callbacks will fail.
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign patient-portal JWTs. This is a SEPARATE auth system from
# the staff dashboard — use a different value from NEXTAUTH_SECRET.
# Generate one with:  openssl rand -base64 32
PORTAL_JWT_SECRET=


# -----------------------------------------------------------------------------
# APPLICATION URL (optional, recommended in production)
# -----------------------------------------------------------------------------

# Public base URL used to build links inside outgoing reminders and emails.
# Falls back to relative links when unset. Set this in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# EMAIL / SMTP (optional)
#
# Powers password resets, appointment reminders, and sales notifications.
# When unset, every email is printed to the server console instead of being
# sent — which is usually what you want in development.
# -----------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address on outgoing mail. Defaults to noreply@clinic-system.local
SMTP_FROM=

# Inbox that receives "request a demo" submissions from the landing page.
# Defaults to SMTP_FROM when unset.
SALES_NOTIFICATION_EMAIL=


# -----------------------------------------------------------------------------
# WHATSAPP REMINDERS via Twilio (optional)
#
# When unset, WhatsApp messages are logged to the console instead of sent.
# Sandbox setup: https://www.twilio.com/docs/whatsapp/sandbox
# -----------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must include the whatsapp: prefix, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=


# -----------------------------------------------------------------------------
# APPOINTMENT REMINDER CRON (optional)
#
# Shared secret required by /api/cron/appointment-reminders. The endpoint
# refuses to run when this is unset, so reminders stay off until you opt in.
# See APPOINTMENT_REMINDERS_SETUP.md for scheduling instructions.
# Generate one with:  openssl rand -hex 32
# -----------------------------------------------------------------------------

CRON_SECRET=


# -----------------------------------------------------------------------------
# AI VISIT SUMMARIES via OpenAI (optional)
#
# When unset, the summary endpoint returns a structured summary built from the
# visit record itself, so the feature keeps working without an API key.
# -----------------------------------------------------------------------------

OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# SUBSCRIPTION BILLING via PayPal (optional)
#
# Only needed if you are charging clinics for access. Create an app at
# https://developer.paypal.com/dashboard/applications
# -----------------------------------------------------------------------------

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live". Credentials must match the mode you choose.
PAYPAL_MODE=sandbox
# Webhook ID from the PayPal dashboard, used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=


# -----------------------------------------------------------------------------
# SEED SCRIPT DEFAULTS (optional — read only by `npm run seed:superadmin`)
#
# CHANGE THE PASSWORD before running the seed against any public deployment.
# -----------------------------------------------------------------------------

SUPER_ADMIN_EMAIL=superadmin@clinic-system.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
